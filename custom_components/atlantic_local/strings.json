    "climate": {
      "heater": {
        "name": "Heater",
        "state_attributes": {
          "preset_mode": {
            "state": {
              "comfort": "Comfort",
              "eco": "Eco",
              "boost": "Boost",
              "frost_protection": "Frost protection",
              "program": "Program",
              "away": "Away"
            }
          }
        }
      }
    },
    "sensor": {
      "room_temperature": {
        "name": "Room temperature"
      },
      "internal_temperature": {
        "name": "Internal temperature"
      },
      "wifi_rssi": {
        "name": "Wi-Fi signal"
      }
    }
